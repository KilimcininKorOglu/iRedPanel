###############################################################################
#                         iRedPanel Configuration                             #
#                                                                             #
#  Settings marked [DB] can also be managed from the Panel Settings UI.       #
#  Database values override .env values. If a [DB] setting is removed from    #
#  the panel_settings table, the .env value (or default) takes effect again.  #
#                                                                             #
#  Settings WITHOUT [DB] must be configured here — they are required before   #
#  the database connection is established.                                    #
###############################################################################


## Mail data backend: ldap, mysql, or pgsql
IREDPANEL_BACKEND=ldap

## Secret key (change this to a random string). It encrypts the bind passwords of
## account resources; after a change, enter those passwords again.
IREDPANEL_SECRET_KEY=change-me-to-a-random-string


###############################################################################
#                       Backend Connection Settings                           #
#                   (must stay in .env — needed at startup)                   #
###############################################################################

## LDAP Settings (required when IREDPANEL_BACKEND=ldap)

# LDAP server URI (ldap:// for plain, ldaps:// for TLS)
IREDPANEL_LDAP_URI=ldap://192.168.2.1

# Base DN of the LDAP directory tree (e.g. dc=example,dc=com)
IREDPANEL_LDAP_ROOT_DN=dc=example,dc=com

# LDAP service account for every request after login and for the CLI tools:
# a global admin email, a CN under the root DN, or a full bind DN (e.g. cn=vmailadmin,dc=example,dc=com)
IREDPANEL_LDAP_USER=postmaster@example.com

# LDAP bind password
IREDPANEL_LDAP_PASSWORD=password

# Verify TLS certificate when connecting to LDAP server
# IREDPANEL_LDAP_TLS_VERIFY=false

## MySQL/MariaDB Settings (required when IREDPANEL_BACKEND=mysql)

# IREDPANEL_MYSQL_HOST=127.0.0.1
# IREDPANEL_MYSQL_PORT=3306
# IREDPANEL_MYSQL_DATABASE=vmail
# IREDPANEL_MYSQL_USER=vmailadmin
# IREDPANEL_MYSQL_PASSWORD=password
# IREDPANEL_VMAIL_PATH=/var/vmail

## PostgreSQL Settings (required when IREDPANEL_BACKEND=pgsql)

# IREDPANEL_PGSQL_HOST=127.0.0.1
# IREDPANEL_PGSQL_PORT=5432
# IREDPANEL_PGSQL_DATABASE=vmail
# IREDPANEL_PGSQL_USER=vmailadmin
# IREDPANEL_PGSQL_PASSWORD=password

# Storage node name for mailbox directory structure (iRedMail default: vmail1)
# IREDPANEL_STORAGE_NODE=vmail1


###############################################################################
#                    Integration Database Connections                          #
#                   (must stay in .env — needed at startup)                   #
###############################################################################

## iRedAdmin Database (enables activity logging + panel settings storage)

# IREDPANEL_IREDADMIN_DB_HOST=127.0.0.1
# IREDPANEL_IREDADMIN_DB_PORT=3306
# IREDPANEL_IREDADMIN_DB_NAME=iredadmin
# IREDPANEL_IREDADMIN_DB_USER=iredadmin
# IREDPANEL_IREDADMIN_DB_PASSWORD=password
# IREDPANEL_ACTIVITY_LOGGING_ENABLED=true  [DB]

## Amavisd Database (required when Amavisd integration is enabled)

# IREDPANEL_AMAVISD_DB_HOST=127.0.0.1
# IREDPANEL_AMAVISD_DB_PORT=3306
# IREDPANEL_AMAVISD_DB_NAME=amavisd
# IREDPANEL_AMAVISD_DB_USER=amavisd
# IREDPANEL_AMAVISD_DB_PASSWORD=password

# Amavisd AM.PDP socket that releases quarantined messages. The host defaults
# to IREDPANEL_AMAVISD_DB_HOST. Amavisd must listen on this address and allow
# the panel's IP in @inet_acl.
# IREDPANEL_AMAVISD_QUARANTINE_HOST=127.0.0.1  [DB]
# IREDPANEL_AMAVISD_QUARANTINE_PORT=9998  [DB]

## iRedAPD Database (required when iRedAPD integration is enabled)

# IREDPANEL_IREDAPD_DB_HOST=127.0.0.1
# IREDPANEL_IREDAPD_DB_PORT=3306
# IREDPANEL_IREDAPD_DB_NAME=iredapd
# IREDPANEL_IREDAPD_DB_USER=iredapd
# IREDPANEL_IREDAPD_DB_PASSWORD=password

## mlmmjadmin RESTful API (required to create, update and delete mailing lists
## and to manage their subscribers). The token is one of `api_auth_tokens` in
## /opt/mlmmjadmin/settings.py on the mail server.

# IREDPANEL_MLMMJADMIN_API_URL=http://127.0.0.1:7790/api  [DB]
# IREDPANEL_MLMMJADMIN_API_TOKEN=  [DB]

## Outgoing SMTP (required for newsletter confirmation mail and the
## quarantine notification CLI). Security: none, starttls or tls.
## Everything but the password is editable in Panel Settings > Outgoing Mail.

# IREDPANEL_SMTP_HOST=127.0.0.1  [DB]
# IREDPANEL_SMTP_PORT=587  [DB]
# IREDPANEL_SMTP_SECURITY=starttls  [DB]
# IREDPANEL_SMTP_TLS_VERIFY=true  [DB]
# IREDPANEL_SMTP_USER=postmaster@example.com  [DB]
# IREDPANEL_SMTP_PASSWORD=password  [DB]
# IREDPANEL_SMTP_FROM=postmaster@example.com  [DB]

## Public base URL of the panel, used in links sent by mail (required for
## newsletter confirmation mail). Never derived from the request Host header.

# IREDPANEL_PUBLIC_URL=https://panel.example.com  [DB]


###############################################################################
#                     Panel Settings (DB-overridable)                          #
#  These serve as initial defaults. Once saved via Panel Settings UI,         #
#  the database value takes precedence over what is defined here.             #
###############################################################################

## Password Policy [DB]

# IREDPANEL_PASSWORD_MIN_LENGTH=8
# IREDPANEL_PASSWORD_INCLUDES_SPECIAL_CHARS=true
# IREDPANEL_PASSWORD_INCLUDES_NUMBERS=true
# IREDPANEL_PASSWORD_INCLUDES_LOWERCASE=true
# IREDPANEL_PASSWORD_INCLUDES_UPPERCASE=true
# IREDPANEL_PASSWORD_HASHES_USE_PREFIXED_SCHEME=true
# IREDPANEL_PASSWORD_DEFAULT_SCHEME=SSHA512

## Password Change [DB]

# IREDPANEL_REQUIRE_OLD_PASSWORD_ON_CHANGE=false

## Password Recovery [DB]
# Publishes /forgot-password. A mailbox with a recovery address gets a reset link
# by mail. Needs IREDPANEL_PUBLIC_URL, the SMTP settings and the iredadmin database.

# IREDPANEL_PASSWORD_RECOVERY_ENABLED=false

## Session & Security [DB]

# IREDPANEL_SESSION_TIMEOUT=1800
# IREDPANEL_ALLOWED_IP_RANGES=
# IREDPANEL_SESSION_VALIDATE_IP=false

## Admin Two-Factor Authentication [DB]
# When on, every admin without a TOTP secret must set one up before the panel
# opens. Needs the iredadmin database and IREDPANEL_SECRET_KEY.

# IREDPANEL_ADMIN_TOTP_REQUIRED=false

## Branding [DB]

# IREDPANEL_BRAND_NAME=iRedPanel
# IREDPANEL_BRAND_LOGO_URL=/static/logo-iredmail.png
# IREDPANEL_BRAND_FOOTER_TEXT=
# IREDPANEL_BRAND_PRIMARY_COLOR=

## Display & Behavior [DB]

# Default UI language for the login page and users without a stored preference.
# Supported: any locale code in locales/, for example en_US, tr_TR, de_DE
# IREDPANEL_DEFAULT_LANGUAGE=en_US
# IREDPANEL_PAGINATION_PER_PAGE=50
# IREDPANEL_CHECK_UPDATES=true
# IREDPANEL_REQUIRE_DOMAIN_OWNERSHIP_VERIFICATION=false

## Newsletter Subscription

# Hours before subscription/unsubscription confirmation tokens expire
# IREDPANEL_NEWSLETTER_EXPIRE_HOURS=24  [DB]

## GeoIP [DB]

# Path to MaxMind GeoLite2-City database file (.mmdb)
# IREDPANEL_GEOIP_DB_PATH=

## Integration Toggles [DB]

# IREDPANEL_AMAVISD_ENABLED=false
# IREDPANEL_AMAVISD_REMOVE_QUARANTINED_IN_DAYS=7
# IREDPANEL_AMAVISD_REMOVE_MAILLOG_IN_DAYS=7
# IREDPANEL_FAIL2BAN_ENABLED=false
# IREDPANEL_FAIL2BAN_SOCKET=
# IREDPANEL_FAIL2BAN_JAILS=dovecot,postfix,postfix-sasl
# IREDPANEL_IREDAPD_ENABLED=false

## REST API [DB]

# IREDPANEL_API_ENABLED=false
# IREDPANEL_API_KEY=
# IREDPANEL_API_ALLOWED_IPS=
